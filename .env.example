DATABASE_NAME="secure-file-statement-delivery-app"
DATABASE_USERNAME=postgres
DATABASE_PASSWORD="secure_password_here"
DATABASE_HOST="db"
DATABASE_PORT=5432

# Cache/Redis configuration
CACHE_HOST="redis"
CACHE_PORT=6379
CACHE_DB=0

# Document storage backend: local | aws | azure | minio
STORAGE_PROVIDER="local"
STORAGE_BUCKET_NAME=""
STORAGE_PREFIX="statements"
STATEMENT_STORAGE_DIR="storage/statements"

# AWS S3 settings
AWS_REGION="af-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Azure Blob Storage settings
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_ACCOUNT_URL=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER="statements"

# MinIO (S3-compatible) settings
MINIO_ENDPOINT_URL="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_SECURE=false

DEBUG=true
FASTAPI_ENV=dev

LOG_LEVEL="INFO"

CORS_ALLOW_ORIGINS="http://localhost:3000,http://localhost:5000,http://0.0.0.0:8000"
STATEMENT_API_KEY="change-this-to-a-long-random-value"
