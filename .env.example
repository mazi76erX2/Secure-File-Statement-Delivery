# Database
DATABASE_NAME="secure-file-statement-delivery-app"
DATABASE_USERNAME=postgres
DATABASE_PASSWORD="secure_password_here"
DATABASE_HOST="db"
DATABASE_PORT=5432

# Cache
CACHE_HOST="redis"
CACHE_PORT=6379
CACHE_DB=0

# Document storage backend: local | aws | azure | minio
STORAGE_PROVIDER="local"
STORAGE_BUCKET_NAME=""
STORAGE_PREFIX="statements"
STATEMENT_STORAGE_DIR="storage/statements"

# AWS S3
AWS_REGION="af-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Azure Blob
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_ACCOUNT_URL=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_CONTAINER="statements"

# MinIO (S3-compatible)
MINIO_ENDPOINT_URL="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_SECURE=false

# Runtime
DEBUG=true
FASTAPI_ENV=dev
LOG_LEVEL="INFO"
CORS_ALLOW_ORIGINS="http://localhost:3000,http://localhost:5000,http://0.0.0.0:8000"
MAX_STATEMENT_FILE_SIZE_BYTES=10485760
PDF_PASSWORD_KDF_ITERATIONS=600000
STATEMENT_DOWNLOAD_RATE_LIMIT_REQUESTS=10
STATEMENT_DOWNLOAD_RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false

# API auth for admin-protected statement endpoints
STATEMENT_API_KEY="change-this-to-a-long-random-value"
